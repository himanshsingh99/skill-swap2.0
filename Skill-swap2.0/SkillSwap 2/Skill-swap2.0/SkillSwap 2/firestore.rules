rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // 1. Public Student Profiles
    // Visible to signed-in students for discovery.
    // Email field is STRICTLY FORBIDDEN here for privacy.
    match /students/{uid} {
      allow read: if signedIn();

      allow create, update: if isOwner(uid)
        && !('email' in request.resource.data)
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.teach is list
        && request.resource.data.teach.size() <= 20
        && request.resource.data.learn is list
        && request.resource.data.learn.size() <= 20;

      allow delete: if isOwner(uid);
    }

    // 2. Private Student Data (Email, Phone)
    // Only accessible by the account owner.
    match /studentsPrivate/{uid} {
      allow read, write: if isOwner(uid);
    }

    // 3. Skill Exchange Requests
    match /requests/{requestId} {
      // Only involved participants can read the request document
      allow read: if signedIn()
        && (
          (request.auth.uid in resource.data.participants) ||
          (resource.data.toUid == request.auth.uid) ||
          (resource.data.fromUid == request.auth.uid)
        );

      // Sender creates the pending request with their verified email
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.fromEmail == request.auth.token.email
        && request.resource.data.fromName is string
        && request.resource.data.toName is string
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 1000
        && request.resource.data.status == "pending"
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.toUid in request.resource.data.participants;

      // Only recipient (toUid) can change status (to "accepted" or "rejected")
      // When accepting, recipient attaches their verified email (toEmail)
      allow update: if signedIn()
        && request.auth.uid == resource.data.toUid
        && resource.data.status == "pending"
        && request.resource.data.status in ["accepted", "rejected"]
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.fromName == resource.data.fromName
        && request.resource.data.toName == resource.data.toName
        && request.resource.data.fromEmail == resource.data.fromEmail
        && request.resource.data.message == resource.data.message
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          request.resource.data.status == "rejected" ||
          (request.resource.data.status == "accepted" && request.resource.data.toEmail == request.auth.token.email)
        );

      // Deletions are disallowed to maintain audit history
      allow delete: if false;
    }
  }
}
